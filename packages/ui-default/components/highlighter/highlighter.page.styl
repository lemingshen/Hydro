@import 'prism-themes/themes/prism-vs.css'

pre, code
  background: $syntax-hl-bg-color

pre > code
  background: none
  line-height: 1.5
  color: black
  text-align: left
  white-space: pre-wrap
  word-spacing: normal
  word-break: normal
  tab-size: 4
  hyphens: none

pre
  position: relative
  padding: rem(5px)
  margin-bottom: rem(20px)

code
  color: $code-color
  font-size: rem($font-size-secondary)

.line-highlight 
  position: absolute
  left: 0
  right: 0
  padding: inherit 0
  margin-top: 1em /* Same as .prism’s padding-top */
  background: hsla(24, 20%, 50%,.08)
  background: linear-gradient(to right, hsla(24, 20%, 50%,.1) 70%, hsla(24, 20%, 50%,0))
  pointer-events: none
  line-height: inherit
  white-space: pre

.sample > .toolbar
  right: 0.9375em !important
  top: 3.7875em !important

.toolbar
  position: absolute
  white-space: nowrap
  right: rem(8px) !important
  top: rem(8px) !important
  padding: 0
  opacity: 0.55 !important
  transition: opacity .15s ease
  font-family: $primary-font-family
  pointer-events: all
  user-select: none

pre:hover > .toolbar,
.code-toolbar:hover .toolbar,
.toolbar:focus-within
  opacity: 1 !important

.toolbar-item
  a
    font-size: rem(12px) !important
    border-radius: rem(6px) !important
    background: none !important
    box-shadow: none !important
    padding: rem(3px) rem(8px) !important

// The copy button: GitHub-style icon-only square. The high-specificity
// selector (and !important on the contested properties) beats Prism's own
// toolbar.css, whose rgba background, .5em radius, 0 .5em padding, and hard
// bottom box-shadow otherwise bleed through and double the outline.
div.code-toolbar > .toolbar > .toolbar-item > a.code-copy-btn,
.toolbar-item a.code-copy-btn
  display: inline-flex
  align-items: center
  justify-content: center
  width: rem(26px)
  height: rem(26px)
  padding: 0 !important
  color: #57606a !important
  background: #ffffff !important
  border: 1px solid #d0d7de
  border-radius: rem(6px) !important
  box-shadow: none !important
  text-decoration: none
  cursor: pointer
  transition: background .12s ease, color .12s ease, border-color .12s ease
  &:hover,
  &:focus
    color: #1f2328 !important
    background: #f3f4f6 !important
    border-color: #b6bec7
    text-decoration: none
  .code-copy-btn__icon
    display: block
    flex: 0 0 auto
  .code-copy-btn__icon--check
    display: none
  &.code-copy-btn--ok
    color: #1a7f37 !important
    border-color: #86d29b
    background: #ecfdf0 !important
    .code-copy-btn__icon--copy
      display: none
    .code-copy-btn__icon--check
      display: block

.scratchpad-fill-button
  display: none

.mode--scratchpad .scratchpad-fill-button
  display: inline-block

.token.tab:not(:empty),
.token.cr,
.token.lf,
.token.space
	position: relative

.token.tab:not(:empty):before,
.token.cr:before,
.token.lf:before,
.token.space:before
	color: #808080
	opacity: 0.6
	position: absolute

.token.tab:not(:empty):before
	content: '\21E5'

.token.cr:before
	content: '\240D'

.token.crlf:before
	content: '\240D\240A'

.token.lf:before
	content: '\240A'

.token.space:before
	content: '\00B7'

@media print {
  .code-toolbar>.toolbar {
    display: none !important;
  }
}