/* ---------- floating tutor panel (shared: solve page + session paper) ---------- */

.sl-float { position: fixed; right: 24px; bottom: 24px; z-index: 950; width: 400px; max-width: calc(100vw - 24px); height: unquote("min(620px, calc(100vh - 90px))"); min-width: 300px; min-height: 360px; background: var(--pta-card); border: 1px solid var(--pta-line); border-radius: var(--pta-radius-lg); box-shadow: var(--pta-shadow-pop); display: flex; flex-direction: column; overflow: hidden; animation: ptaPopIn .26s var(--pta-ease); }
.sl-float__resize { position: absolute; left: 0; top: 0; width: 18px; height: 18px; cursor: nwse-resize; touch-action: none; z-index: 2; }
.sl-float__resize::after { content: ''; position: absolute; left: 4px; top: 4px; width: 10px; height: 10px; border-left: 2px solid rgba(255, 255, 255, .65); border-top: 2px solid rgba(255, 255, 255, .65); border-radius: 3px 0 0 0; transition: border-color .15s ease; }
.sl-float__resize:hover::after { border-color: #fff; }
.sl-float--expanded .sl-float__resize { display: none; }
.sl-float__header { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 9px 12px 9px 26px; background: var(--pta-grad-crimson); background-size: 220% 100%; animation: ptaSheen 11s ease infinite; box-shadow: 0 2px 8px rgba(158, 35, 53, .35); flex: 0 0 auto; }
.sl-float__title { font-weight: bold; font-size: 14px; letter-spacing: .01em; color: #fff; text-shadow: 0 1px 2px rgba(0, 0, 0, .18); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sl-spark-chip { margin-left: auto; margin-right: 6px; flex: 0 0 auto; background: rgba(255, 255, 255, .18); color: #fff; border: 1px solid rgba(255, 255, 255, .35); border-radius: 999px; font-size: 11px; font-weight: bold; padding: 2px 10px; cursor: pointer; transition: background-color .15s ease, transform .15s var(--pta-ease); }
.sl-spark-chip:hover { background: rgba(255, 255, 255, .3); transform: translateY(-1px); }
.sl-spark-chip:empty { display: none !important; }
.sl-float__hint { color: #a4707d; font-size: 11px; line-height: 1.45; margin: 0; padding: 6px 12px 9px; flex: 0 0 auto; background: linear-gradient(180deg, var(--pta-card), var(--pta-crimson-soft)); border-top: 1px solid var(--pta-crimson-line); }
.pta-dark .sl-float__hint,
.theme--dark .sl-float__hint { color: #b98b96; background: linear-gradient(180deg, var(--pta-card), #221f22); }
.sl-chat { flex: 1 1 auto; overflow-y: auto; overscroll-behavior: contain; padding: 0 12px 10px; background: var(--pta-card-2); scrollbar-width: thin; scrollbar-color: rgba(158, 35, 53, .3) transparent; }
/* Content scrolling under the header fades out instead of hard-clipping
   against it (the sticky strip pins to the scrollport top and doubles as
   the log's breathing room). */
.sl-chat::before { content: ''; display: block; position: sticky; top: 0; height: 14px; margin: 0 -12px -4px; background: linear-gradient(180deg, var(--pta-card-2) 30%, transparent); z-index: 1; pointer-events: none; }
.sl-float .sl-chat::-webkit-scrollbar,
.sl-input-row textarea::-webkit-scrollbar { width: 8px; }
.sl-float .sl-chat::-webkit-scrollbar-track,
.sl-input-row textarea::-webkit-scrollbar-track { background: transparent; }
.sl-float .sl-chat::-webkit-scrollbar-thumb,
.sl-input-row textarea::-webkit-scrollbar-thumb { background: rgba(158, 35, 53, .28); border-radius: 8px; border: 2px solid transparent; background-clip: content-box; }
.sl-float .sl-chat::-webkit-scrollbar-thumb:hover,
.sl-input-row textarea::-webkit-scrollbar-thumb:hover { background-color: rgba(158, 35, 53, .45); }
.pta-dark .sl-float .sl-chat::-webkit-scrollbar-thumb,
.theme--dark .sl-float .sl-chat::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, .22); border: 2px solid transparent; background-clip: content-box; }
.sl-input-row { display: flex; align-items: flex-end; gap: 8px; margin: 0; padding: 8px 10px; border-top: 1px solid var(--pta-crimson-line); flex: 0 0 auto; background: var(--pta-card); }
/* One line tall by default; the page script grows it with the content up to
   max-height and enables scrolling only past it (numbers mirrored by the
   refined block near the end of this file and by autoGrowPanelInput). */
.sl-input-row textarea { flex: 1 1 auto; resize: none; height: 44px; min-height: 44px; max-height: 120px; overflow-y: hidden; border-radius: 12px; line-height: 1.45; padding: 9px 12px; scrollbar-width: thin; transition: background-color .15s ease, border-color .15s ease; }
.sl-input-row textarea:focus { border-color: var(--pta-crimson) !important; box-shadow: var(--pta-ring-crimson) !important; }
.sl-input-row textarea:disabled { background: var(--pta-card-3); border-color: var(--pta-line); color: var(--pta-ink-faint); cursor: not-allowed; box-shadow: none; }
.sl-input-row button { align-self: flex-end; flex: 0 0 auto; }
.sl-input-row button:disabled { opacity: .55; filter: saturate(.35); box-shadow: none !important; cursor: not-allowed; }
.sl-float .sl-input-row .button.primary { background: var(--pta-grad-crimson); border-color: transparent; box-shadow: 0 6px 14px -6px rgba(158, 35, 53, .6); }
.sl-float .sl-input-row .button.primary:hover { background: var(--pta-grad-crimson); filter: brightness(1.08); }
@media (max-width: 600px) {
  .sl-float { right: 8px; left: 8px; bottom: 8px; width: auto; max-width: none; height: unquote("min(560px, calc(100vh - 60px))"); }
  .sl-fab { right: 12px; bottom: 12px; }
  .sl-float__resize { display: none; }
}
.sl-float__qtag { flex: 0 0 auto; margin-left: auto; background: rgba(255, 255, 255, .22); color: #fff; border-radius: 999px; font-size: 10.5px; font-weight: bold; padding: 2px 10px; letter-spacing: .03em; white-space: nowrap; cursor: pointer; transition: background-color .15s ease, transform .15s var(--pta-ease); }
.sl-float__qtag:hover { background: rgba(255, 255, 255, .34); transform: translateY(-1px); }
.sl-float__qtag:focus-visible { outline: 2px solid rgba(255, 255, 255, .85); outline-offset: 2px; }

/* Expanded mode is a reading pane: wider gutters, and bubbles capped so
   tutor prose never stretches into 700px-long lines. */
.sl-float--expanded .sl-chat { padding-left: 20px; padding-right: 20px; }
.sl-float--expanded .sl-chat::before { margin-left: -20px; margin-right: -20px; }
.sl-float--expanded .sl-bubble { max-width: 620px; }
.sl-float--expanded .sl-input-row { padding: 10px 16px; }

/* ------------------- session paper: in-place answering ------------------- */

html.page--self_learning_paper .paper-q__foot { display: flex; align-items: center; gap: 12px; border-top: 1px dashed var(--pta-line); }
html.page--self_learning_paper .paper-q__hint { font-size: 12px; color: var(--pta-ink-faint); }
html.page--self_learning_paper .paper-q__status { display: none; margin-left: 10px; font-size: 12px; font-weight: bold; border-radius: 999px; padding: 2px 12px; border: 1px solid var(--pta-line); background: var(--pta-card-3); color: var(--pta-ink-soft); vertical-align: 2px; animation: ptaScaleIn .2s var(--pta-ease); }
html.page--self_learning_paper .paper-q__status.on { display: inline-block; }
