@media (max-width: 760px) {
  .pta-hero { flex-direction: column; align-items: stretch; gap: 14px; padding: 20px; }
  .pta-hero__glyph { display: none; }
  .pta-hero__actions .pta-hero__btn { flex: 1 1 auto; justify-content: center; }
}

/* --------------------------- immersive auth pages ---------------------------- */
/* Login / register / lost-password share layout--immersive: the stock photo
   background becomes a brand gradient with soft light pools, and the form
   becomes a frosted card with the gradient hairline on top. */

html.layout--immersive .main {
  position: relative;
  background: linear-gradient(135deg, #17253f 0%, #1f2f55 45%, #33245e 100%);
}

html.layout--immersive .main::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(620px 300px at 15% 18%, rgba(77, 171, 247, 0.28), transparent 60%),
    radial-gradient(700px 340px at 85% 82%, rgba(151, 117, 250, 0.26), transparent 60%);
  pointer-events: none;
}

html.layout--immersive .immersive--content {
  position: relative;
  max-width: 400px;
  margin: 0 auto;
  background: rgba(20, 26, 40, 0.55);
