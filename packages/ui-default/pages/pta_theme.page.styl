.theme--dark .slm .token.operator, .theme--dark .slm .token.punctuation, .theme--dark .sl-attempt .token.operator, .theme--dark .sl-attempt .token.punctuation { color: #c8ccd0; background: none; }
.theme--dark .slm .token.property, .theme--dark .slm .token.variable, .theme--dark .slm .token.attr-name, .theme--dark .sl-attempt .token.property, .theme--dark .sl-attempt .token.variable { color: #9cdcfe; }
