/* ========================================================================== */
/*  PASS 2 — layout & baseline refresh                                        */
/*  Homepage hero, immersive auth card, typography, form controls, menus,     */
/*  pagination pills, status chips, empty states, footer strip, page-scoped   */
/*  table upgrades. Everything below rides the PASS-1 tokens and keyframes.   */
/* ========================================================================== */

/* ------------------------------- typography -------------------------------- */

body,
button, input, select, textarea,
.textbox, .select {
  font-family: 'Inter var', Inter, 'Segoe UI', system-ui, -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans CJK SC', sans-serif;
}

.data-table, .slm__table, .sbt__table, .bau__table, .aisd__mtable, .pager {
  font-variant-numeric: tabular-nums;
}

::selection { background: rgba(77, 171, 247, 0.28); }
.theme--dark ::selection { background: rgba(77, 171, 247, 0.4); }

input[type='checkbox'], input[type='radio'] { accent-color: var(--pta-primary); }

.typo a:not(.button) {
  text-underline-offset: 3px;
  transition: color 0.15s ease, text-decoration-color 0.15s ease;
}

/* ---------------------------- dropdown menus -------------------------------- */

.dropdown-target.menu {
  border: 1px solid var(--pta-line);
  border-radius: 12px;
  background: var(--pta-card);
  box-shadow: var(--pta-shadow-pop);
  padding: 6px;
}

.dropdown-target.menu .menu__item { border-radius: 8px; overflow: hidden; }

.dropdown-target.menu .menu__link {
  border-radius: 8px;
  transition: background 0.12s ease, color 0.12s ease;
}

.dropdown-target.menu .menu__link:hover,
.typo .dropdown-target.menu .menu__link:hover {
  background: var(--pta-blue-soft);
  color: var(--pta-blue-text);
}

.theme--dark .dropdown-target.menu { background: #262b31; }

/* ---------------------------- pagination pills ------------------------------ */

.pager { font-size: 13px; }

.pager.pager-top, .pager.pager-bottom { border-color: transparent; }
.pager.pager-top .pager__item, .pager.pager-bottom .pager__item { border-color: transparent; }

.pager .pager__item {
  padding: 6px 13px;
  margin: 0 2px;
  border-radius: 999px;
  transition: background 0.15s ease, color 0.15s ease, transform 0.15s var(--pta-ease);
}

.pager .pager__item.link, .typo .pager .pager__item.link { color: var(--pta-ink-faint); }

.pager .pager__item.link:hover, .typo .pager .pager__item.link:hover {
  background: var(--pta-blue-soft);
  color: var(--pta-blue-text);
  border-color: transparent;
  transform: translateY(-1px);
}

.pager .pager__item.current {
  background: var(--pta-grad-btn);
  color: #fff !important;
  border-color: transparent !important;
  box-shadow: 0 4px 12px -4px rgba(28, 126, 214, 0.55);
}

/* ------------------------------ status chips -------------------------------- */
/* Verdicts everywhere (record tables, statistics, scratchpad rows) become
   soft pills; the per-status text colors from core keep their !important. */

.record-status--text {
  display: inline-block;
  padding: 1px 10px;
  border-radius: 999px;
  font-size: 12.5px;
  font-weight: 500;
  background: var(--pta-card-3);
  border: 1px solid var(--pta-line);
  line-height: 1.5;
}

.record-status--text.pass { background: var(--pta-ok-soft); border-color: var(--pta-ok-line); }
.record-status--text.fail { background: var(--pta-bad-soft); border-color: var(--pta-bad-line); }
.record-status--text.progress { background: var(--pta-blue-soft); border-color: var(--pta-blue-line); }

/* ------------------------------ empty states -------------------------------- */

.nothing-placeholder {
  padding: 34px 16px;
  text-align: center;
  color: var(--pta-ink-faint);
  background: var(--pta-card-2);
  border: 1px dashed var(--pta-line);
  border-radius: var(--pta-radius);
}

.nothing-placeholder.compact { padding: 18px 12px; }
.nothing-icon { opacity: 0.55; }

/* ------------------------------ footer strip -------------------------------- */
/* After the link columns were removed the footer is a single utility strip —
   make it read as intentional: slim, quiet, hairline-separated. */

.footer .footer__extra-link { padding: 12px 0; }
.footer .footer__extra-link-item { font-size: 12px; opacity: 0.85; }
.footer .footer__extra-link-item:hover { opacity: 1; }

/* --------------------- page-scoped: record & problem tables ------------------ */

html.page--record_main .data-table thead th {
  position: sticky;
  top: 45px;
  z-index: 5;
}

html.page--problem_main .data-table .col--title a { font-weight: 600; }

html.page--problem_main .data-table td .icon.star-icon,
html.page--problem_main .data-table td .star .icon {
  transition: color 0.15s ease, transform 0.15s var(--pta-ease);
}

html.page--problem_main .data-table td .star:hover .icon,
html.page--problem_main .data-table td .icon.star-icon:hover {
  color: var(--pta-gold);
  transform: scale(1.15);
}

/* --------------------------- homepage course hero ---------------------------- */
/* The pass-2 signature: every domain home opens with its own banner — the
   domain's initial as a watermark glyph, the course name, a greeting, and
   the two actions this platform is actually about. */

.pta-hero {
  position: relative;
  overflow: hidden;
  border-radius: var(--pta-radius-lg);
  background: linear-gradient(120deg, #1f6fd0 0%, #6b4ce0 100%);
