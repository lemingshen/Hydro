html.page--self_learning_paper .paper-q__status.fail { background: var(--pta-bad-soft); border-color: var(--pta-bad-line); color: var(--pta-bad-text); }
html.page--self_learning_paper .paper-mk--pass { background: var(--pta-ok-soft) !important; border-color: var(--pta-ok-line) !important; border-radius: 8px; }
html.page--self_learning_paper .paper-mk--fail { background: var(--pta-bad-soft) !important; border-color: var(--pta-bad-line) !important; border-radius: 8px; }
html.page--self_learning_paper .paper-mk--partial { background: var(--pta-gold-soft) !important; border-color: var(--pta-gold-line) !important; border-radius: 8px; }

/* -------------------- session paper: schedule notes -------------------- */

html.page--self_learning_paper .paper-note--warn { background: var(--pta-gold-soft); border: 1px solid var(--pta-gold-line); color: var(--pta-gold-text); border-radius: 10px; margin-top: 6px; }
html.page--self_learning_paper .paper-note--closed { background: var(--pta-card-3); border: 1px solid var(--pta-line); color: var(--pta-ink-soft); border-radius: 10px; margin-top: 6px; }

/* ------------- session-style row lists (Homework / Test parity) ------------- */
/*
 * The self-learning homepage's approved row anatomy — date tile · title +
 * count pill · chips · centered Delete + arrow — extracted for the Homework
 * and Test lists. Fresh .pta-row namespace so no legacy era (.homework__*,
 * .contest__*, .sll-*) can interfere, and `display` is stated explicitly:
 * the sll fifth-era lesson, applied preemptively.
 */
.pta-rowlist { display: grid; grid-template-columns: 1fr; gap: 12px; margin: 4px 0 2px; padding: 0; list-style: none; }
.pta-rowlist > .pta-rowwrap { border: none; padding: 0; }
.pta-rowwrap { position: relative; width: 100%; animation: ptaFadeUp .3s var(--pta-ease) backwards; }
.pta-rowlist > .pta-rowwrap:nth-child(1) { animation-delay: .02s; }
.pta-rowlist > .pta-rowwrap:nth-child(2) { animation-delay: .05s; }
.pta-rowlist > .pta-rowwrap:nth-child(3) { animation-delay: .08s; }
.pta-rowlist > .pta-rowwrap:nth-child(4) { animation-delay: .11s; }
.pta-rowlist > .pta-rowwrap:nth-child(5) { animation-delay: .14s; }
.pta-rowlist > .pta-rowwrap:nth-child(6) { animation-delay: .17s; }
.pta-rowlist > .pta-rowwrap:nth-child(7) { animation-delay: .2s; }
.pta-rowlist > .pta-rowwrap:nth-child(8) { animation-delay: .23s; }
.pta-row { display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 16px; width: 100%; position: relative; overflow: hidden; padding: 13px 18px 13px 14px; border: 1px solid var(--pta-line); border-radius: var(--pta-radius); background: var(--pta-card); box-shadow: var(--pta-shadow); text-decoration: none; color: inherit; transition: transform .16s var(--pta-ease), box-shadow .16s ease, border-color .16s ease; }
.pta-row::before { content: ''; position: absolute; left: 0; top: 0; right: 0; height: 4px; background: var(--pta-grad); opacity: .9; }
.pta-row:hover { transform: translateY(-3px); border-color: var(--pta-blue-line); box-shadow: 0 14px 30px -12px rgba(28, 126, 214, .35); }
.theme--dark .pta-row:hover { box-shadow: 0 14px 30px -12px rgba(0, 0, 0, .6); }
.pta-row__side { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; min-width: 64px; }
.pta-datebox { text-align: center; min-width: 60px; padding: 5px 10px; border-radius: 10px; background: var(--pta-card-3); border: 1px solid var(--pta-line-soft); }
.pta-datebox__num { font-size: 23px; font-weight: bold; line-height: 1.1; color: var(--pta-ink); }
.pta-datebox__sub { font-size: 10.5px; color: var(--pta-ink-faint); letter-spacing: .03em; }
.pta-row__main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 7px; padding-right: 30px; }
.pta-rowwrap:has(.list-del--card) .pta-row__main { padding-right: 116px; }
.pta-row__titlerow { display: flex; align-items: center; gap: 10px; min-width: 0; }
.pta-row__title { font-size: 16px; font-weight: bold; color: var(--pta-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color .16s ease; }
.pta-row:hover .pta-row__title { color: var(--pta-blue-text); }
.pta-row__count { flex: 0 0 auto; font-size: 11.5px; font-weight: bold; color: var(--pta-blue-text); background: var(--pta-blue-soft); border: 1px solid var(--pta-blue-line); border-radius: 999px; padding: 2px 10px; }
.pta-row__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; }
.pta-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; color: var(--pta-ink-soft); background: var(--pta-card-3); border: 1px solid var(--pta-line); border-radius: 999px; padding: 2px 9px; }
.pta-chip .icon { font-size: 12px; }
.pta-chip--ok { background: var(--pta-ok-soft); border-color: var(--pta-ok-line); color: var(--pta-ok-text); }
.pta-chip--gold { background: var(--pta-gold-soft); border-color: var(--pta-gold-line); color: var(--pta-gold-text); }
.pta-chip--blue { background: var(--pta-blue-soft); border-color: var(--pta-blue-line); color: var(--pta-blue-text); }
.pta-chip--dim { opacity: .75; }
.pta-row__go { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 15px; color: var(--pta-ink-faint); transition: transform .16s var(--pta-ease), color .16s ease; }
.pta-row:hover .pta-row__go { color: var(--pta-blue-text); transform: translateY(-50%) translateX(3px); }
.pta-rowwrap .list-del--card { top: 50%; transform: translateY(-50%); right: 44px; }
@media (max-width: 600px) {
  .pta-row { gap: 10px; padding: 11px 12px; }
  .pta-row__side { min-width: 48px; }
  .pta-datebox { min-width: 46px; }
  .pta-datebox__num { font-size: 18px; }
  .pta-row__titlerow { flex-wrap: wrap; }
  .pta-row__main { padding-right: 24px; }
  .pta-rowwrap:has(.list-del--card) .pta-row__main { padding-right: 92px; }
  .pta-rowwrap .list-del--card { right: 36px; }
}

/* Bottom rhythm under the row lists: the pager clears the last row, and the
   (toggleable) calendar clears the pager — Homework and Test get the same
   spacing the Self-Learning page defines locally. */
.pta-rowlist + .pager { margin: 18px 0 6px; }
.pta-rowlist ~ div[name='calendar_entry'] { margin-top: 14px; }

/* -------------- picker selected items (.autocomplete-tag) -------------- */
/*
 * Upstream ships the multi-picker's selected items as harsh solid-red tags
 * with no dark styling. Restyled on the token triples so both themes get
 * the same soft pill the rest of the design uses; drag/close affordances
 * inherit the text color.
 */
.autocomplete-wrapper .autocomplete-tag {
  background: var(--pta-blue-soft);
  border: 1px solid var(--pta-blue-line);
  color: var(--pta-blue-text);
  border-radius: 999px;
  padding: 2px 10px;
  font-weight: 600;
  line-height: 1.7;
}
.autocomplete-wrapper .autocomplete-tag:hover { filter: brightness(1.06); }

/* ================================================================== */
/*  PTA fork — AI tutor pop-up window (refined). Appended so these      */
/*  rules override the earlier .sl-float / .sl-chat / .sl-msg styles.   */
/* ================================================================== */
.sl-float { width: 420px; min-width: 320px; border: none; border-radius: 18px; box-shadow: 0 30px 70px -28px rgba(20, 10, 40, 0.55), 0 0 0 1px var(--pta-line); }
/* The header doubles as the window's drag handle (self_learning_solve.page.js
   initPanelDrag): grab cursors on the empty frame, own cursors on controls. */
.sl-float__header { padding: 11px 12px 11px 30px; background: linear-gradient(120deg, #5f3dc4, #7048e8 55%, #9c36b5); background-size: 100% 100%; animation: none; box-shadow: 0 2px 10px rgba(95, 61, 196, 0.35); cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; }
.sl-float__header:active { cursor: grabbing; }
.sl-float__title { font-size: 14px; font-weight: 700; letter-spacing: 0; text-shadow: none; }
@keyframes slTutorOnline { 0%, 100% { box-shadow: 0 0 0 3px rgba(105, 219, 124, 0.25); } 50% { box-shadow: 0 0 0 5px rgba(105, 219, 124, 0.1); } }
.sl-float__title::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #69db7c; margin: 0 8px 1px 0; box-shadow: 0 0 0 3px rgba(105, 219, 124, 0.25); animation: slTutorOnline 2.6s ease-in-out infinite; }
.sl-float__resize::after { border-color: rgba(255, 255, 255, 0.6); }
.sl-hbtn { width: 28px; height: 28px; border-radius: 8px; background: rgba(255, 255, 255, 0.12); color: #fff; cursor: pointer; }
.sl-hbtn:hover { background: rgba(255, 255, 255, 0.26); transform: none; }
.sl-chat { padding: 0 14px 8px; background: var(--pta-card); }
/* Keep the under-header fade in step with THIS block's background and
   padding (the base rule earlier in the file uses the card-2 tint). */
.sl-chat::before { height: 14px; margin: 0 -14px -4px; background: linear-gradient(180deg, var(--pta-card) 30%, transparent); }
.sl-empty { color: var(--pta-ink-faint); font-size: 12.5px; text-align: center; padding: 26px 12px; }
.sl-msg { margin: 10px 0; gap: 8px; align-items: flex-end; }
.sl-msg.assistant::before { content: '🤖'; flex: 0 0 26px; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 14px; background: var(--pta-violet-soft); border: 1px solid var(--pta-violet-line); }
.sl-bubble { max-width: 86%; padding: 9px 12px; border-radius: 14px; font-size: 13px; line-height: 1.55; box-shadow: none; }
.sl-msg.assistant .sl-bubble { background: var(--pta-card-2); border: 1px solid var(--pta-line); color: var(--pta-ink); border-bottom-left-radius: 4px; }
.sl-msg.user .sl-bubble { background: #7048e8; color: #fff; border: none; border-bottom-right-radius: 4px; box-shadow: 0 8px 18px -12px #7048e8; }
.sl-msg.user .sl-bubble code { background: rgba(255, 255, 255, 0.18); color: #fff; }
.sl-loc { font-size: 10.5px; font-weight: 600; letter-spacing: 0.02em; color: var(--pta-violet-text); margin-bottom: 4px; }
.sl-msg.user .sl-loc { color: rgba(255, 255, 255, 0.8); }
.sl-bubble code { background: var(--pta-violet-soft); color: var(--pta-violet-text); }
.sl-bubble blockquote { border-left-color: var(--pta-violet-line); background: var(--pta-violet-soft); }
.sl-bubble--note { background: var(--pta-ok-soft) !important; border: 1px solid var(--pta-ok-line) !important; color: var(--pta-ok-text); }
.sl-divider { margin: 16px 0 10px; font-size: 11.5px; }
.sl-divider span { background: var(--pta-card-2); }
.sl-input-row { padding: 10px 12px; gap: 8px; align-items: flex-end; border-top: 1px solid var(--pta-line); background: var(--pta-card); }
/* One line tall by default; the page script (autoGrowPanelInput) raises the
   inline height with the content and flips overflow to auto only past
   max-height — so no scrollbar ever shows for a mere placeholder. */
.sl-input-row textarea { height: 44px; min-height: 44px; max-height: 120px; overflow-y: hidden; border-radius: 14px !important; padding: 11px 14px !important; font-size: 13px; font-family: inherit; line-height: 1.45; }
.sl-input-row textarea:focus { border-color: #7048e8 !important; box-shadow: 0 0 0 3px var(--pta-violet-soft) !important; }
.sl-input-row textarea:disabled { opacity: 0.65; }
.sl-input-row button { margin-left: 0; width: 42px; height: 42px; padding: 0 !important; border-radius: 50% !important; font-size: 0 !important; line-height: 0; flex: 0 0 auto; }
.sl-input-row button::before { content: '➤'; font-size: 15px; line-height: 42px; }
.sl-float .sl-input-row .button.primary { background: #7048e8; box-shadow: 0 8px 18px -10px #7048e8; }
.sl-float .sl-input-row .button.primary:hover { background: #5f3dc4; filter: none; }
.sl-float .sl-input-row .button.primary:disabled { opacity: 0.45; box-shadow: none; }
.sl-float__hint { font-size: 11px; color: var(--pta-ink-faint); padding: 2px 16px 12px; background: var(--pta-card); border-top: none; }
.sl-fab { background: linear-gradient(135deg, #7048e8, #9c36b5); box-shadow: 0 14px 30px -10px rgba(112, 72, 232, 0.6), 0 0 0 5px rgba(112, 72, 232, 0.14); }
.sl-fab:hover { box-shadow: 0 16px 34px -10px rgba(112, 72, 232, 0.7), 0 0 0 7px rgba(112, 72, 232, 0.16); }
.pta-dark .sl-float { box-shadow: 0 30px 70px -28px rgba(0, 0, 0, 0.8), 0 0 0 1px #3d3750; }
.pta-dark .sl-chat { background: #1c1a26; }
.pta-dark .sl-msg.assistant .sl-bubble { background: #262333; border-color: #3d3750; color: #e7e3f5; }
.pta-dark .sl-msg.assistant::before { background: #322a48; border-color: #4a3d6b; }
.pta-dark .sl-bubble code { background: #322a48; color: #cdbdfb; }
.pta-dark .sl-input-row, .pta-dark .sl-float__hint { background: #1c1a26; border-color: #3d3750; }
.pta-dark .sl-divider span { background: #262333; }
