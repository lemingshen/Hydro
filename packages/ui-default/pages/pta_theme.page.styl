/* ------------------- attempts panel v2 (pass 2.1) --------------------------- */
/* Shared by the problem page, the self-learning solve page and the record
   page: header with count + best score, structured rows (attempt number,
   verdict pill, language/time, score) with a verdict-toned score bar, newest
   first, and older rows folded behind one expander. */

.sl-attempts__head { display: flex; align-items: center; gap: 8px; margin: 0; }
.sl-attempts__head h3 { margin: 0; font-size: 15px; color: var(--pta-ink); }
.sl-attempts__count { font-size: 11.5px; font-weight: bold; background: var(--pta-card-3); border: 1px solid var(--pta-line); border-radius: 999px; padding: 1px 9px; color: var(--pta-ink-soft); }
.sl-attempts__best { margin-left: auto; font-size: 11.5px; font-weight: bold; border-radius: 999px; padding: 2px 10px; background: var(--pta-bad-soft); border: 1px solid var(--pta-bad-line); color: var(--pta-bad-text); }
.sl-attempts__best.pass { background: var(--pta-ok-soft); border-color: var(--pta-ok-line); color: var(--pta-ok-text); }

.sl-attempt summary { position: relative; display: flex; align-items: center; gap: 8px; padding: 10px 12px 13px; }
.sl-attempt__num { font: 600 11.5px/1 ui-monospace, Consolas, monospace; color: var(--pta-ink-faint); flex: 0 0 auto; }
.sl-attempt__meta { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--pta-ink-faint); font-size: 12px; }
.sl-attempt__score { flex: 0 0 auto; font-weight: 700; font-size: 13px; color: var(--pta-ink-soft); font-variant-numeric: tabular-nums; }
.sl-attempt__score.pass { color: var(--pta-ok-text); }
.sl-attempt__score.part { color: var(--pta-warn-text); }
.sl-attempt__score.zero { color: var(--pta-bad-text); }
.sl-attempt__bar { position: absolute; left: 12px; right: 12px; bottom: 5px; height: 3px; border-radius: 999px; opacity: 0.9; transform-origin: left; transform: scaleX(0); transition: transform 0.4s var(--pta-ease); background: linear-gradient(90deg, #ff8787, #e03131); }
.sl-attempt__bar.part { background: linear-gradient(90deg, #ffc078, #e8590c); }
.sl-attempt__bar.pass { background: linear-gradient(90deg, #69db7c, #2f9e44); }

.sl-attempts__rest[hidden] { display: none; }
.sl-attempts__more { display: block; width: 100%; margin-top: 10px; padding: 8px 10px; font-size: 12.5px; color: var(--pta-ink-soft); background: var(--pta-card-2); border: 1px dashed var(--pta-line); border-radius: 12px; cursor: pointer; transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
.sl-attempts__more:hover { background: var(--pta-blue-soft); color: var(--pta-blue-text); border-color: var(--pta-blue-line); }


